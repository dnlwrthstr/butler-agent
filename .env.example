# Copy this file to .env (or Butler Agent/task/agent/.env) and fill in your key.
# Never commit the real .env file - it is listed in .gitignore.
OPENAI_API_KEY=your-api-key

# Optional: point the client at an OpenAI-compatible proxy (e.g. LiteLLM).
# Leave unset to use api.openai.com.
# OPENAI_BASE_URL=https://your-proxy.example.com/v1
